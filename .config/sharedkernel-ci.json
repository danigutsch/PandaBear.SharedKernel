{
  "version": 1,
  "solution": "SharedKernel.slnx",
  "selection": {
    "fullValidation": [
      ".config/*",
      ".github/*",
      "*.props",
      "*.targets",
      "*.slnx",
      "*.globalconfig",
      ".editorconfig",
      ".gitattributes",
      "global.json",
      "NuGet.Config",
      "tests/SharedKernel.Style.Analyzers.Tests/*",
      "tests/testconfig.json",
      "tests/xunit.runner.json"
    ],
    "documentation": [
      "docs/*",
      "provenance/*",
      "README.md",
      "LICENSE.txt",
      "AGENTS.md"
    ],
    "alwaysSelected": [],
    "requireCoveringTests": false,
    "testPaths": [
      {
        "paths": ["tests/SharedKernel.Npgsql.Testing.Host/*"],
        "tests": [
          "tests/SharedKernel.EntityFrameworkCore.Tests/SharedKernel.EntityFrameworkCore.Tests.csproj",
          "tests/SharedKernel.EventSourcing.Npgsql.Tests/SharedKernel.EventSourcing.Npgsql.Tests.csproj",
          "tests/SharedKernel.Npgsql.Tests/SharedKernel.Npgsql.Tests.csproj"
        ]
      }
    ]
  },
  "slices": [
    {
      "name": "library",
      "projects": []
    },
    {
      "name": "postgres",
      "projects": [
        "tests/SharedKernel.EntityFrameworkCore.Tests/SharedKernel.EntityFrameworkCore.Tests.csproj",
        "tests/SharedKernel.EventSourcing.Npgsql.Tests/SharedKernel.EventSourcing.Npgsql.Tests.csproj",
        "tests/SharedKernel.Npgsql.Tests/SharedKernel.Npgsql.Tests.csproj"
      ],
      "service": {
        "project": "tests/SharedKernel.Npgsql.Testing.Host/SharedKernel.Npgsql.Testing.Host.csproj",
        "readyFileVariable": "SHAREDKERNEL_TESTING_POSTGRESQL_READY_FILE",
        "valueVariable": "SHAREDKERNEL_TESTING_POSTGRESQL_CONNECTION_STRING",
        "stopTimeoutSeconds": 180
      }
    }
  ],
  "defaultSlice": "library"
}
