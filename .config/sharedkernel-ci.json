{
  "version": 1,
  "solution": "SharedKernel.slnx",
  "selection": {
    "fullValidation": [
      ".config/*",
      ".github/*",
      "*.props",
      "*.targets",
      "*.slnx",
      "*.globalconfig",
      ".editorconfig",
      ".gitattributes",
      "global.json",
      "NuGet.Config",
      "tests/SharedKernel.Style.Analyzers.Tests/*",
      "tests/testconfig.json",
      "tests/xunit.runner.json"
    ],
    "documentation": [
      "docs/*",
      "provenance/*",
      "README.md",
      "LICENSE.txt",
      "AGENTS.md"
    ],
    "alwaysSelected": [],
    "requireCoveringTests": false,
    "testPaths": [
      {
        "paths": ["tests/SharedKernel.TestServices.Host/*"],
        "tests": [
          "tests/SharedKernel.Aspire.Hosting.Umami.Tests/SharedKernel.Aspire.Hosting.Umami.Tests.csproj",
          "tests/SharedKernel.EntityFrameworkCore.Tests/SharedKernel.EntityFrameworkCore.Tests.csproj",
          "tests/SharedKernel.EventSourcing.Npgsql.Tests/SharedKernel.EventSourcing.Npgsql.Tests.csproj",
          "tests/SharedKernel.Npgsql.Tests/SharedKernel.Npgsql.Tests.csproj"
        ]
      },
      {
        "paths": ["src/SharedKernel/SharedKernel.CI/ServiceConfiguration.cs", "src/SharedKernel/SharedKernel.CI/ServiceHost.cs"],
        "tests": [
          "tests/SharedKernel.Aspire.Hosting.Umami.Tests/SharedKernel.Aspire.Hosting.Umami.Tests.csproj",
          "tests/SharedKernel.CI.Tests/SharedKernel.CI.Tests.csproj",
          "tests/SharedKernel.EntityFrameworkCore.Tests/SharedKernel.EntityFrameworkCore.Tests.csproj",
          "tests/SharedKernel.EventSourcing.Npgsql.Tests/SharedKernel.EventSourcing.Npgsql.Tests.csproj",
          "tests/SharedKernel.Npgsql.Tests/SharedKernel.Npgsql.Tests.csproj",
          "tests/SharedKernel.Repository.Tests/SharedKernel.Repository.Tests.csproj"
        ]
      }
    ]
  },
  "slices": [
    {
      "name": "library",
      "projects": []
    },
    {
      "name": "browser",
      "projects": [
        "tests/SharedKernel.Blazor.Site.Tests/SharedKernel.Blazor.Site.Tests.csproj",
        "tests/SharedKernel.PageSections.Blazor.Tests/SharedKernel.PageSections.Blazor.Tests.csproj",
        "tests/SharedKernel.Testing.Tests/SharedKernel.Testing.Tests.csproj"
      ],
      "playwright": {
        "project": "tests/SharedKernel.Testing.Tests/SharedKernel.Testing.Tests.csproj",
        "browsers": ["chromium"],
        "onlyShell": true
      }
    },
    {
      "name": "services",
      "projects": [
        "tests/SharedKernel.Aspire.Hosting.Umami.Tests/SharedKernel.Aspire.Hosting.Umami.Tests.csproj",
        "tests/SharedKernel.EntityFrameworkCore.Tests/SharedKernel.EntityFrameworkCore.Tests.csproj",
        "tests/SharedKernel.EventSourcing.Npgsql.Tests/SharedKernel.EventSourcing.Npgsql.Tests.csproj",
        "tests/SharedKernel.Npgsql.Tests/SharedKernel.Npgsql.Tests.csproj"
      ],
      "service": {
        "project": "tests/SharedKernel.TestServices.Host/SharedKernel.TestServices.Host.csproj",
        "readyFileVariable": "SHAREDKERNEL_TESTING_SERVICES_READY_FILE",
        "valueVariables": ["SHAREDKERNEL_TESTING_POSTGRESQL_CONNECTION_STRING", "SHAREDKERNEL_TESTING_UMAMI_CONNECTION_STRING"],
        "readyTimeoutSeconds": 600,
        "stopTimeoutSeconds": 180
      }
    }
  ],
  "defaultSlice": "library",
  "coverage": {
    "thresholdPercent": 90,
    "include": [
      "src/*.cs",
      "tools/*.cs"
    ],
    "exclude": [
      "*/obj/*",
      "*.g.cs",
      "*.generated.cs"
    ],
    "symbolDirectories": [
      "src",
      "tools"
    ]
  }
}
