<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>SharedKernel.Blazor.Site.Tests</RootNamespace>
        <!-- The browser tests host an Interactive Server page, which needs the framework's blazor.web.js static web asset. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Bunit" />
        <Using Include="SharedKernel.Blazor.Site" />
        <Using Include="SharedKernel.Testing.Assertions" />
        <Using Include="SharedKernel.Testing.Web" />
        <Using Include="SharedKernel.Testing.Playwright" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="bunit" />
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="coverlet.MTP">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.AspNetCore\SharedKernel.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Blazor.Site\SharedKernel.Blazor.Site.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Testing\SharedKernel.Testing.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Testing.Playwright\SharedKernel.Testing.Playwright.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Testing.Assertions\SharedKernel.Testing.Assertions.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Testing.Web\SharedKernel.Testing.Web.csproj" />
    </ItemGroup>

</Project>
