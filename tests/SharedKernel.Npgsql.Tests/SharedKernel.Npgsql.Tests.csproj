<Project Sdk="Aspire.AppHost.Sdk">

    <PropertyGroup>
        <!-- Npgsql.EntityFrameworkCore.PostgreSQL has no stable 11.x yet, so the PostgreSQL slice stays on net10.0. A single
             TargetFramework keeps the Aspire AppHost SDK out of the multi-framework outer build, which it does not support. -->
        <TargetFrameworks></TargetFrameworks>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>PandaBear.Npgsql.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="PandaBear.Testing" />
        <Using Include="Npgsql" />
        <Using Include="PandaBear.Npgsql.Testing" />
        <Using Include="PandaBear.Npgsql" />
        <Using Include="PandaBear.Testing.Assertions" />
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
        <PackageReference Include="Aspire.Hosting.Testing" />
        <PackageReference Include="coverlet.MTP">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.Npgsql.Testing/SharedKernel.Npgsql.Testing.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="../SharedKernel.Npgsql.Testing.Host/SharedKernel.Npgsql.Testing.Host.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.IntegrationTesting\SharedKernel.IntegrationTesting.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Npgsql\SharedKernel.Npgsql.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Testing.Assertions\SharedKernel.Testing.Assertions.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Testing\SharedKernel.Testing.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="../../src/SharedKernel/SharedKernel.Testing.Xunit/SharedKernel.Testing.Xunit.csproj" IsAspireProjectResource="false" />
    </ItemGroup>

</Project>
