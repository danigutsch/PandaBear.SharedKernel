        <Compile Include="..\SharedKernel.Processes.Tests\GitEnvironmentGroup.cs" Link="Shared\GitEnvironmentGroup.cs" />
        <Compile Include="..\SharedKernel.Processes.Tests\HostileGitEnvironment.cs" Link="Shared\HostileGitEnvironment.cs" />
        <Compile Include="..\SharedKernel.Processes.Tests\LinuxProcessState.cs" Link="Shared\LinuxProcessState.cs" />
