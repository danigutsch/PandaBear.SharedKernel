<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

    <PropertyGroup>
        <!-- Tool target frameworks. Add net11.0 when global.json moves to an 11.0 SDK; see docs/dotnet-multi-targeting.md. -->
        <SharedKernelToolTargetFrameworks Condition="'$(SharedKernelToolTargetFrameworks)' == ''">net10.0</SharedKernelToolTargetFrameworks>
        <TargetFramework></TargetFramework>
        <TargetFrameworks>$(SharedKernelToolTargetFrameworks)</TargetFrameworks>
        <!-- A net10.0 tool also runs where only a later major runtime, such as .NET 11, is installed. -->
        <RollForward>Major</RollForward>
    </PropertyGroup>

</Project>
