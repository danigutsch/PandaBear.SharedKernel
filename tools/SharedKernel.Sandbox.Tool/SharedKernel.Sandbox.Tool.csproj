<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>sandbox</ToolCommandName>
        <PackageId>PandaBear.SharedKernel.Sandbox.Tool</PackageId>
        <Description>Probes what the current sandboxed environment allows, such as Unix sockets, named pipes, and writing to the temp and NuGet folders, and explains what that means for .NET tools.</Description>
        <RootNamespace>SharedKernel.Sandbox.Tool</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>sandbox;dotnet;agents;dotnet-tool</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Sandbox.Tool.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.CommandLine\SharedKernel.CommandLine.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Sandbox.ClaudeCode\SharedKernel.Sandbox.ClaudeCode.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Sandbox\SharedKernel.Sandbox.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
