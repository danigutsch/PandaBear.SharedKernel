<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>syspackages</ToolCommandName>
        <PackageId>PandaBear.SharedKernel.Packages.Tool</PackageId>
        <Description>Compares the packages that .config/sharedkernel-packages.json declares per package manager with the installed packages, read-only, and refuses a declaration in which a package has more than one owner.</Description>
        <RootNamespace>SharedKernel.Packages.Tool</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>packages;apt;cargo;npm;flatpak;snap;homebrew;dotnet-tool</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Packages.Tool.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.CommandLine\SharedKernel.CommandLine.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Packages\SharedKernel.Packages.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Processes\SharedKernel.Processes.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Terminal.Gui\SharedKernel.Terminal.Gui.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
