<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>sharedkernel-vault</ToolCommandName>
        <PackageId>PandaBear.SharedKernel.VaultManager.Tool</PackageId>
        <RootNamespace>PandaBear.VaultManager.Tool</RootNamespace>
        <Description>Offline review, secret detection, deduplication, and merging of Keeper and Bitwarden vault exports for Bitwarden or Vaultwarden import.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>password-manager;bitwarden;vaultwarden;keeper;migration;dotnet-tool;shared-kernel</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.VaultManager.Tool.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Secrets\bip39-english.txt" LogicalName="PandaBear.VaultManager.Tool.Secrets.bip39-english.txt" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
