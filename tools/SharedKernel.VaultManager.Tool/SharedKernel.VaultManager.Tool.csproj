<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>vault</ToolCommandName>
        <PackageId>PandaBear.SharedKernel.VaultManager.Tool</PackageId>
        <RootNamespace>SharedKernel.VaultManager.Tool</RootNamespace>
        <Description>Offline review, secret detection, deduplication, and merging of Keeper and Bitwarden vault exports for Bitwarden or Vaultwarden import.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>password-manager;bitwarden;vaultwarden;keeper;migration;dotnet-tool;shared-kernel</PackageTags>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.VaultManager.Tool.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Terminal.Gui" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Terminal.Gui\SharedKernel.Terminal.Gui.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Vault.Bitwarden\SharedKernel.Vault.Bitwarden.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Vault.Import\SharedKernel.Vault.Import.csproj" />
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Vault\SharedKernel.Vault.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
