<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <PackageId>PandaBear.SharedKernel.PlaywrightMcp.Tool</PackageId>
        <ToolCommandName>sharedkernel-playwright-mcp</ToolCommandName>
        <Description>Reusable Playwright MCP browser automation tool.</Description>
        <RootNamespace>PandaBear.PlaywrightMcp.Tool</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.PlaywrightMcp.Tool.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
