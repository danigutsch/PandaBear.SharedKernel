<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>PandaBear.Versioning.Tool</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>sharedkernel-version</ToolCommandName>
        <PackageId>PandaBear.SharedKernel.Versioning.Tool</PackageId>
        <Description>Local and CI versioning automation for SharedKernel release flows.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>versioning;semver;conventional-commits;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Versioning\SharedKernel.Versioning.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../Shared/CandidateManifest.cs" Link="Shared/CandidateManifest.cs" />
        <Compile Include="../Shared/ExecutableResolver.cs" Link="Shared/ExecutableResolver.cs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Versioning.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
