<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.ImageSanitizing</PackageId>
        <Description>Dependency-free upload sanitizing for JPEG, PNG, WebP and opt-in AVIF: format recognition by content, metadata removal without re-encoding, animation detection, and header dimensions.</Description>
        <RootNamespace>PandaBear.ImageSanitizing</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>image;upload;metadata;exif;avif;animation;privacy;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Results\SharedKernel.Results.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
