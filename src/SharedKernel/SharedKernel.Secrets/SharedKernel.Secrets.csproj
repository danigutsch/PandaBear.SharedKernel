<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Secrets</PackageId>
        <Description>age and SOPS secrets engine: validated recipients, identity references, and creation rules, a SOPS metadata reader that fails closed, repository verification against the creation rules, and the operations of sharedkernel-secrets over the IAgeTool and ISopsTool seams.</Description>
        <PackageTags>secrets;age;sops;shared-kernel;dotnet</PackageTags>
        <RootNamespace>PandaBear.Secrets</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- LibraryImport generates its marshalling code with pointers; Libc.cs is the only native interop. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Secrets.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.ConfigurationFiles\SharedKernel.ConfigurationFiles.csproj" />
        <ProjectReference Include="..\SharedKernel.Encodings\SharedKernel.Encodings.csproj" />
        <ProjectReference Include="..\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
        <ProjectReference Include="..\SharedKernel.IO\SharedKernel.IO.csproj" />
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
        <ProjectReference Include="..\SharedKernel.Results\SharedKernel.Results.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
