<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Secrets</PackageId>
        <Description>age and SOPS secrets engine: validated recipients, identity references, and creation rules, process adapters for age, age-keygen, and sops that keep secrets on stdin and stdout, and an exact recipient-set check.</Description>
        <PackageTags>secrets;age;sops;shared-kernel;dotnet</PackageTags>
        <RootNamespace>PandaBear.Secrets</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Secrets.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.Results\SharedKernel.Results.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
