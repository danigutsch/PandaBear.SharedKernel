<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.SecretScanning</PackageId>
        <Description>Finds secrets in text: a catalog of credential, key, and token rules with checksum and structure validators, TOTP, recovery code, seed phrase, card number, and IBAN detection, and PEM and SSH private key inspection and conversion. It reports where a secret is and never stores the value.</Description>
        <PackageTags>secrets;secret-scanning;credentials;ssh;totp;shared-kernel;dotnet</PackageTags>
        <RootNamespace>PandaBear.SecretScanning</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.SecretScanning.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.Encodings\SharedKernel.Encodings.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="bip39-english.txt" LogicalName="PandaBear.SecretScanning.bip39-english.txt" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
