<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.GitHub</PackageId>
        <Description>GitHub API access for command-line tools: reading the GH_TOKEN or GITHUB_TOKEN token the way gh does, keeping it away from child processes, and creating an HttpClient with the GitHub REST headers.</Description>
        <PackageTags>github;api;tokens;command-line;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.GitHub.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
