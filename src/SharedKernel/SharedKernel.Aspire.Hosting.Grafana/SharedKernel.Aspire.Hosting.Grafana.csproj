<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Aspire.Hosting.Grafana</PackageId>
        <Description>Aspire hosting extensions for local Grafana LGTM observability stacks.</Description>
        <RootNamespace>PandaBear.Aspire.Hosting.Grafana</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/danigutsch/ViajantesTurismo</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>aspire;grafana;observability;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" />
        <PackageReference Include="CommunityToolkit.Aspire.Hosting.OpenTelemetryCollector" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>

    <!-- Transitional consumer test access; remove after moving internal tests behind public contracts. -->
    <ItemGroup>
        <InternalsVisibleTo Include="ViajantesTurismo.ArchitectureTests" />
    </ItemGroup>
</Project>
