# SharedKernel analyzer hardening exceptions.
#
# These are intentional public API shapes. Remove these entries only with a
# breaking API redesign that replaces the established Option<T>/Result<T>
# factories or mediator marker contracts.

# Alpha packages keep source public API baseline enforcement, but package compatibility
# overload guidance is advisory until the SharedKernel packages move beyond 0.y.z.
[*.cs]
dotnet_diagnostic.RS0026.severity = none

[SharedKernel.Results/Option?T?.cs]
dotnet_diagnostic.CA1000.severity = none

[SharedKernel.Results/Result?T?.cs]
dotnet_diagnostic.CA1000.severity = none

[SharedKernel.Mediator.Abstractions/ICommand.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/ICommand?TResponse?.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/INotification.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/IQuery.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/IRequest.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/IStreamCommand?TResponse?.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/IStreamQuery?TResponse?.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Mediator.Abstractions/IStreamRequest.cs]
dotnet_diagnostic.CA1040.severity = none

# DDD contracts intentionally use marker interfaces and conventional handler names.
# Owner: SharedKernel maintainers. Remove if these contracts gain behavior or are renamed in a major version.
[SharedKernel.Domain/IAggregateRoot.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Domain/IDomainEvent.cs]
dotnet_diagnostic.CA1040.severity = none

[SharedKernel.Messaging.IntegrationEvents/IIntegrationEventHandler.cs]
dotnet_diagnostic.CA1711.severity = none

# Exception types need standard constructor overloads, which do not fit primary-constructor style well.
# Owner: SharedKernel maintainers. Remove if exception guidance changes.
[SharedKernel.EventSourcing/ExpectedStreamRevisionConflictException.cs]
csharp_style_prefer_primary_constructors = false:none

# Npgsql adapter SQL is schema-qualified from validated quoted identifiers. The adapter is a
# low-level library with no synchronization-context dependency.
# Owner: SharedKernel maintainers. Remove if the adapter moves to generated SQL or a query builder.
[SharedKernel.EventSourcing.Npgsql/*.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2100.severity = none

# Transaction-scoped advisory locking is a low-level raw Npgsql primitive with fixed, parameterized SQL.
# Owner: SharedKernel maintainers. Remove if this module adopts a provider-neutral persistence abstraction.
[SharedKernel.Npgsql/*.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2100.severity = none

# Each trait holder is a distinct TestTraits type in its own namespace; a shared file name would collide in one folder.
# Owner: SharedKernel maintainers. Remove if the holders gain unique type names.
[SharedKernel.Testing/SharedKernel*TestTraits.cs]
dotnet_diagnostic.SKSTYLE016.severity = none
