@inherits SiteComponent
<section class="@CssClass("site-hero")" @attributes="AdditionalAttributes">
    <div class="site-hero__text">
        <h1 class="site-hero__title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="site-hero__subtitle">@Subtitle</p>
        }
        @if (Actions is not null)
        {
            <div class="site-hero__actions">@Actions</div>
        }
    </div>
    @if (Image is not null)
    {
        <div class="site-hero__media">@ResponsiveImageMarkup.Render(Image, eager: true, highPriority: true)</div>
    }
</section>
