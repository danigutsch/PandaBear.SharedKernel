@inherits SiteComponent
@if (Albums.Count > 0)
{
    <CardGrid @attributes="AdditionalAttributes" Class="@CssClass("site-album-index")" MinColumnWidth="@MinColumnWidth" MaxColumnWidth="@MaxColumnWidth" Gap="@Gap">
        @for (var index = 0; index < Albums.Count; index++)
        {
            var album = Albums[index];
            <Card @key="album.Href.Value" Title="@album.Title" Href="@album.Href" Image="@album.Cover" EagerImage="@(index < EagerCount)" HeadingLevel="@HeadingLevel" TitleLanguage="@album.TitleLanguage"
                  Style="@CardStyle" ImageAspect="@ImageAspect" ImageShadow="@ImageShadow" TextAlignment="@TextAlignment" MoreText="@MoreText" MoreVariant="@MoreVariant" ButtonSize="@ButtonSize">
                @if (!string.IsNullOrWhiteSpace(album.PhotoCountText))
                {
                    <p class="site-album-index__count">@album.PhotoCountText</p>
                }
            </Card>
        }
    </CardGrid>
}
