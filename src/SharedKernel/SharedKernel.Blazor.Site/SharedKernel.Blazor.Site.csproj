<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Blazor.Site</PackageId>
        <Description>Brand-neutral, accessible, JavaScript-free site components for static server rendering, with one design-token stylesheet.</Description>
        <RootNamespace>SharedKernel.Blazor.Site</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>blazor;razor-components;accessibility;css;static-ssr;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.BuildingBlocks/SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="../SharedKernel.ContentRights/SharedKernel.ContentRights.csproj" />
        <ProjectReference Include="../SharedKernel.InputNormalization/SharedKernel.InputNormalization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Blazor.Site.Tests" />
    </ItemGroup>

</Project>
