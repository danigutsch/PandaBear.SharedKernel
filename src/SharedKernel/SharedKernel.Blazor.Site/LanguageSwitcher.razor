@inherits SiteComponent
<nav class="@CssClass("site-language-switcher")" aria-label="@Label" @attributes="AdditionalAttributes">
    <ul>
        @foreach (var language in Languages)
        {
            <li><a href="@language.Href.Value" hreflang="@language.Culture" lang="@language.Culture" aria-current="@(language.IsCurrent ? "true" : null)">@language.Label</a></li>
        }
    </ul>
</nav>
