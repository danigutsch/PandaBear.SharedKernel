@inherits SiteComponent
<div class="@CssClass(RootClass)" @attributes="AdditionalAttributes">
    @for (var index = 0; index < Images.Count; index++)
    {
        var image = Images[index];
        var priority = PrioritizeFirstImage && index == 0;
        var picture = ResponsiveImageMarkup.Render(image.Image, eager: priority || index < EagerCount, highPriority: priority, sizes: EffectiveSizes);
        <figure class="site-image-grid__item">
            @if (image.Href is null)
            {
                @picture
            }
            else
            {
                <a class="site-image-grid__link" href="@image.Href.Value">@picture</a>
            }
            @if (!string.IsNullOrWhiteSpace(image.Caption))
            {
                <figcaption>@image.Caption</figcaption>
            }
        </figure>
    }
</div>
