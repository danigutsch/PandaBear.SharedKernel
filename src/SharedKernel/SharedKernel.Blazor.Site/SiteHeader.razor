@inherits SiteComponent
<header class="@CssClass(Placement == HeaderPlacement.OverHero ? "site-header site-header--over-hero" : "site-header")" @attributes="AdditionalAttributes">
    <div class="site-header__inner">
        @if (Brand is not null)
        {
            <div class="site-header__brand">@Brand</div>
        }
        @if (HasMenu)
        {
            <details class="site-header__menu">
                <summary class="site-header__toggle">@MenuLabel</summary>
                @Navigation
            </details>
        }
        else
        {
            @Navigation
        }
    </div>
</header>

@code {
    private RenderFragment Navigation => @<text>
        @if (Items.Count > 0)
        {
            <nav class="site-nav" aria-label="@Label">
                <ul class="site-nav__list">
                    @foreach (var item in Items)
                    {
                        @if (item.Children is { Count: > 0 } children)
                        {
                            <li class="site-nav__item">
                                <details class="site-nav__group">
                                    <summary aria-current="@CurrentGroup(item)">@item.Text</summary>
                                    <ul class="site-nav__sublist">
                                        @foreach (var child in children)
                                        {
                                            <li><a href="@child.Href?.Value" aria-current="@Current(child)">@child.Text</a></li>
                                        }
                                    </ul>
                                </details>
                            </li>
                        }
                        else
                        {
                            <li class="site-nav__item"><a href="@item.Href?.Value" aria-current="@Current(item)">@item.Text</a></li>
                        }
                    }
                </ul>
            </nav>
        }
        @if (Actions is not null)
        {
            <div class="site-header__actions">@Actions</div>
        }
    </text>;
}
