@inherits SiteComponent
<section class="@CssClass(Media is null ? "site-section" : "site-section site-section--split")" aria-labelledby="@HeadingId" @attributes="AdditionalAttributes">
    @if (Media is null)
    {
        @Text
    }
    else
    {
        <div class="site-section__main">@Text</div>
        <div class="site-section__media">@Media</div>
    }
</section>

@code {
    private RenderFragment TitleText => builder => builder.AddContent(0, Title);

    private RenderFragment Text => @<text>
        <div class="site-section__header">
            @Heading.Render(Level, "site-section__title", HeadingId, TitleText)
            @if (Divider)
            {
                <div class="site-divider" aria-hidden="true"></div>
            }
            @if (!string.IsNullOrWhiteSpace(Intro))
            {
                <p class="site-section__intro">@Intro</p>
            }
        </div>
        <div class="site-section__body">@ChildContent</div>
    </text>;
}
