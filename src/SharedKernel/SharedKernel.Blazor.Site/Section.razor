@inherits SiteComponent
<section class="@CssClass(RootClass)" aria-labelledby="@HeadingId" @attributes="AdditionalAttributes">
    @if (Media is null)
    {
        @Text
    }
    else
    {
        <Split Media="Media">@Text</Split>
    }
</section>

@code {
    private RenderFragment TitleText => builder => builder.AddContent(0, Heading);

    private RenderFragment Text => @<text>
        <div class="site-section__header">
            @HeadingGroup.Render(HeadingGroupClasses.Section, Eyebrow, HeadingMarkup.Render(Level, "site-section__title", HeadingId, TitleText, TitleLanguage))
            @if (Divider)
            {
                <div class="site-divider" aria-hidden="true"></div>
            }
            @if (!string.IsNullOrWhiteSpace(Intro))
            {
                <p class="site-section__intro">@Intro</p>
            }
        </div>
        <div class="site-section__body">@ChildContent</div>
    </text>;
}
