@inherits SiteComponent
<section class="@CssClass("site-theme-preview")" aria-label="@Texts.Label" @attributes="AdditionalAttributes" id="@ScopeId" data-theme="@ThemeNames.Css(Scheme)" data-width="@(Narrow ? "narrow" : "wide")">
    <style nonce="@Nonce">@((MarkupString)_css)</style>
    <div class="site-theme-preview__sample" inert>
        <nav class="site-nav" aria-label="@Texts.NavigationLabel">
            <span class="site-theme-preview__brand">@Texts.Brand</span>
            <ul>
                <li><a href="#" aria-current="page">@Texts.NavigationCurrent</a></li>
                <li><a href="#">@Texts.NavigationOther</a></li>
            </ul>
        </nav>
        <div class="site-theme-preview__h1">@Texts.Heading1</div>
        <div class="site-theme-preview__h2">@Texts.Heading2</div>
        <div class="site-theme-preview__h3">@Texts.Heading3</div>
        <p>@Texts.Paragraph <a href="#">@Texts.Link</a>.</p>
        <p><small>@Texts.Small</small></p>
        <p>
            <a class="site-button site-button--primary" href="#">@Texts.PrimaryButton</a>
            <a class="site-button site-button--secondary" href="#">@Texts.SecondaryButton</a>
        </p>
        <article class="site-card">
            <div class="site-card__title site-theme-preview__h3">@Texts.CardTitle</div>
            <p>@Texts.CardText</p>
        </article>
    </div>
    <table class="site-theme-preview__contrast">
        <caption>@Texts.ContrastCaption (@SchemeName)</caption>
        <thead>
            <tr>
                <th scope="col">@Texts.PairColumn</th>
                <th scope="col">@Texts.RatioColumn</th>
                <th scope="col">@Texts.RequiredColumn</th>
                <th scope="col">@Texts.ResultColumn</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var check in _contrast)
            {
                <tr>
                    <th scope="row">
                        <span class="site-theme-preview__swatch" aria-hidden="true" data-foreground="@ThemeNames.Css(check.Foreground)" data-background="@ThemeNames.Css(check.Background)">Aa</span>
                        @PairName(check)
                    </th>
                    <td>@SiteThemeRules.FormatRatio(check.Ratio)</td>
                    <td>@SiteThemeRules.FormatMinimum(check.Minimum)</td>
                    <td>@(check.Passes ? Texts.Pass : Texts.Fail)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (_issues.Count > 0)
    {
        <ul class="site-theme-preview__issues">
            @foreach (var (field, message, isError) in _issues)
            {
                <li data-field="@field"><strong>@(isError ? Texts.Error : Texts.Warning)</strong> @field: @message</li>
            }
        </ul>
    }
</section>
