@inherits SiteComponent
<article class="@CssClass(RootClass)" @attributes="AdditionalAttributes">
    @if (Image is not null)
    {
        <div class="site-card__media">@ResponsiveImageMarkup.Render(Image, eager: EagerImage, highPriority: false)</div>
    }
    <div class="site-card__body">
        @if (HasEyebrow)
        {
            <hgroup class="site-card__heading">
                <p class="site-card__eyebrow">@Eyebrow</p>
                @Heading.Render(HeadingLevel, "site-card__title", null, TitleContent, TitleLanguage)
            </hgroup>
        }
        else
        {
            @Heading.Render(HeadingLevel, "site-card__title", null, TitleContent, TitleLanguage)
        }
        @ChildContent
    </div>
    @if (HasMore || Actions is not null)
    {
        <ActionRow Class="site-card__actions">
            @if (HasMore)
            {
                <span class="@(ButtonStyle.Classes(MoreVariant, MoreSize) + " site-card__more")" aria-hidden="true">@MoreText</span>
            }
            @Actions
        </ActionRow>
    }
</article>

@code {
    private RenderFragment TitleContent => Href is null ? @<text>@Title</text> : @<a href="@Href.Value">@Title</a>;
}
