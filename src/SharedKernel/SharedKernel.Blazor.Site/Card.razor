@inherits SiteComponent
<article class="@CssClass(RootClass)" @attributes="AdditionalAttributes">
    @if (Image is not null)
    {
        <div class="site-card__media">@ResponsiveImageMarkup.Render(Image, eager: EagerImage, highPriority: false)</div>
    }
    <div class="site-card__body">
        @if (Image is not null && ImageCredit is not null)
        {
            <ImageCreditCaption Credit="@ImageCredit" />
        }
        @TitleGroup@ChildContent
    </div>
    @if (HasMore || Actions is not null)
    {
        <ActionRow Class="site-card__actions" Justification="@(TextAlignment == SiteAlignment.Center ? ActionRowJustification.Center : ActionRowJustification.Start)">
            @if (HasMore)
            {
                <span class="@(ButtonStyle.Classes(MoreVariant, MoreSize) + " site-card__more")" aria-hidden="true">@MoreText</span>
            }
            @Actions
        </ActionRow>
    }
</article>

@code {
    private RenderFragment TitleGroup => HeadingGroup.Render(HeadingGroupClasses.Card, Eyebrow, HeadingMarkup.Render(HeadingLevel, "site-card__title", null, TitleContent, TitleLanguage));

    private RenderFragment TitleContent => Href is null ? @<text>@Heading</text> : @<a href="@Href.Value">@Heading</a>;
}
