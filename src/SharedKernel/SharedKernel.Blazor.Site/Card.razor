@inherits SiteComponent
<article class="@CssClass("site-card")" @attributes="AdditionalAttributes">
    @if (ImageSrc is not null && ImageAlt is not null)
    {
        <div class="site-card__media">
            <img src="@ImageSrc.Value" alt="@ImageAlt.Text" width="@ImageWidth" height="@ImageHeight" loading="lazy" />
        </div>
    }
    <div class="site-card__body">
        @Heading.Render(HeadingLevel, "site-card__title", null, TitleContent)
        @ChildContent
    </div>
    @if (Actions is not null)
    {
        <div class="site-card__actions">@Actions</div>
    }
</article>

@code {
    private RenderFragment TitleContent => Href is null ? @<text>@Title</text> : @<a href="@Href.Value">@Title</a>;
}
