<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Packages</PackageId>
        <Description>Package manager model and read-only engine: validated package names and versions, the .config/sharedkernel-packages.json declaration, installed-state readers, a plan of missing or mismatched packages, and update decisions against advisories and a minimum release age.</Description>
        <PackageTags>packages;apt;cargo;npm;flatpak;snap;homebrew;osv;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Packages.Tests" />
        <InternalsVisibleTo Include="SharedKernel.Packages.Tool" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.ConfigurationFiles\SharedKernel.ConfigurationFiles.csproj" />
        <ProjectReference Include="..\SharedKernel.Domain\SharedKernel.Domain.csproj" />
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
        <ProjectReference Include="..\SharedKernel.Results\SharedKernel.Results.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
