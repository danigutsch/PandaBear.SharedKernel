<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Caching</PackageId>
        <Description>Dependency-free in-process caching helpers, such as a read cache keyed by a shared revision number so edits from any process show without a message bus.</Description>
        <RootNamespace>PandaBear.Caching</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>caching;revision;read-model;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
