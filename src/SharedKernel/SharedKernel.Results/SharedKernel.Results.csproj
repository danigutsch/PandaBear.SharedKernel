<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Results</PackageId>
        <Description>Core result primitives for shared-kernel workflows.</Description>
        <RootNamespace>PandaBear.Results</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>results;shared-kernel;functional;dotnet</PackageTags>
        <PackCompilerOutputs>true</PackCompilerOutputs>
    </PropertyGroup>

    <ItemGroup>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Results.SourceGenerator\SharedKernel.Results.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            PackCompilerOutput="true"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
            IsAspireProjectResource="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
