<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Testing.Playwright</PackageId>
        <Description>Reusable Playwright assertions for SharedKernel browser test suites.</Description>
        <RootNamespace>PandaBear.Testing.Playwright</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;playwright;browser;assertions;shared-kernel;dotnet</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
        <EnableSharedKernelTestingAnalyzers>true</EnableSharedKernelTestingAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SharedKernel.Testing.AspNetCore\SharedKernel.Testing.AspNetCore.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Playwright" />
      <PackageReference Include="Microsoft.Playwright.Xunit.v3" />
    </ItemGroup>

</Project>
