<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <PackageId>PandaBear.SharedKernel.EventSourcing.Npgsql</PackageId>
    <Description>Npgsql adapter for SharedKernel event-sourcing primitives.</Description>
    <RootNamespace>SharedKernel.EventSourcing.Npgsql</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>event-sourcing;npgsql;postgresql;shared-kernel;dotnet</PackageTags>
  </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.EventSourcing\SharedKernel.EventSourcing.csproj" />
        <ProjectReference Include="..\SharedKernel.Npgsql\SharedKernel.Npgsql.csproj" />
        <ProjectReference Include="..\SharedKernel.PostgreSql\SharedKernel.PostgreSql.csproj" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharedKernel.Observability\DurationBuckets.cs" Link="DurationBuckets.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharedKernel.EventSourcing.Npgsql.Tests" />
  </ItemGroup>

</Project>
