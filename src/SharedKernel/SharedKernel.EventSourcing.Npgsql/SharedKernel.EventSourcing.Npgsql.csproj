<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PandaBear.SharedKernel.EventSourcing.Npgsql</PackageId>
    <Description>Npgsql adapter for SharedKernel event-sourcing primitives.</Description>
    <RootNamespace>PandaBear.EventSourcing.Npgsql</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>event-sourcing;npgsql;postgresql;shared-kernel;dotnet</PackageTags>
  </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.EventSourcing\SharedKernel.EventSourcing.csproj" />
        <ProjectReference Include="..\SharedKernel.Npgsql\SharedKernel.Npgsql.csproj" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
