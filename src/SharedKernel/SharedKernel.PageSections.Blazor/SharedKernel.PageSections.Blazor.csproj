<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.PageSections.Blazor</PackageId>
        <Description>Renders typed page sections with the accessible site components: each section on the band of its tone, its parts in a fixed order, its images as a mosaic or beside the text.</Description>
        <RootNamespace>SharedKernel.PageSections.Blazor</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>blazor;razor-components;pages;sections;static-ssr;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.Blazor.Site/SharedKernel.Blazor.Site.csproj" />
        <ProjectReference Include="../SharedKernel.PageSections/SharedKernel.PageSections.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
