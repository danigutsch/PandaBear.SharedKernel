<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework></TargetFramework>
        <TargetFrameworks>$(SharedKernelTargetFrameworks)</TargetFrameworks>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Testing.Sqlite</PackageId>
        <Description>A private in-memory SQLite database per test, kept alive by an open connection and released with its pooled connections.</Description>
        <RootNamespace>PandaBear.Testing.Sqlite</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;sqlite;in-memory;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    </ItemGroup>

</Project>
