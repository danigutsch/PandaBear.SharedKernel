<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Testing.Http</PackageId>
        <Description>Reusable HTTP response helpers for SharedKernel test suites.</Description>
        <RootNamespace>PandaBear.Testing.Http</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;http;shared-kernel;dotnet</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
        <EnableSharedKernelTestingAnalyzers>true</EnableSharedKernelTestingAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.Testing.Assertions/SharedKernel.Testing.Assertions.csproj" />
    </ItemGroup>

    <!-- The userMessage overloads forward through an internal copy of the helper, so no call crosses package internals. -->
    <ItemGroup>
        <Compile Include="../SharedKernel.Testing.Assertions/UserMessageAssertions.cs" Link="UserMessageAssertions.cs" />
    </ItemGroup>

</Project>
