<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Repositories.GitHub</PackageId>
        <Description>GitHub provider for PandaBear.SharedKernel.Repositories: label sync, roadmap projection to issues and Projects, reconciliation and import, integrity-bound roadmap automation, sub-issue links, and dependency snapshot submission.</Description>
        <PackageTags>repository;github;roadmap;labels;dependency-graph;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Repositories.GitHub.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.GitHub\SharedKernel.GitHub.csproj" />
        <ProjectReference Include="..\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
        <ProjectReference Include="..\SharedKernel.IO\SharedKernel.IO.csproj" />
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
        <ProjectReference Include="..\SharedKernel.Repositories\SharedKernel.Repositories.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
