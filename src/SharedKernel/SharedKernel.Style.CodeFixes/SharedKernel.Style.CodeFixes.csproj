<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>PandaBear.SharedKernel.Style.CodeFixes</PackageId>
        <Description>Code fixes for repository style conventions.</Description>
        <RootNamespace>SharedKernel.Style.CodeFixes</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>style;code-fixes;shared-kernel;dotnet</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <PackCompilerOutputs>true</PackCompilerOutputs>
        <PackOwnCompilerOutput>true</PackOwnCompilerOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Style.Analyzers\SharedKernel.Style.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" PackCompilerOutput="true" />
        <Compile Include="..\SharedKernel.Style.Analyzers\StyleDiagnosticIds.cs" Link="StyleDiagnosticIds.cs" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\SharedKernel.Style.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
    </ItemGroup>

</Project>
