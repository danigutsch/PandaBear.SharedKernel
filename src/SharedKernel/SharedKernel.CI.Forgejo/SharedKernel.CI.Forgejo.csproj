    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.CI\SharedKernel.CI.csproj" />
        <ProjectReference Include="..\SharedKernel.Forgejo\SharedKernel.Forgejo.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
