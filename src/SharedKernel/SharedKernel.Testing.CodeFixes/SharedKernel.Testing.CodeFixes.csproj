<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>SharedKernel.Testing.CodeFixes</PackageId>
        <Description>Code fixes for repository test conventions.</Description>
        <RootNamespace>SharedKernel.Testing.CodeFixes</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;code-fixes;shared-kernel;dotnet</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Testing.Analyzers\SharedKernel.Testing.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <Compile Include="..\SharedKernel.Testing.Analyzers\TestingDiagnosticIds.cs" Link="TestingDiagnosticIds.cs" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\SharedKernel.Testing.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
        <None Include="..\SharedKernel.Testing.Analyzers\bin\$(Configuration)\netstandard2.0\SharedKernel.Testing.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Link="SharedKernel.Testing.Analyzers.dll" Visible="false" />
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
