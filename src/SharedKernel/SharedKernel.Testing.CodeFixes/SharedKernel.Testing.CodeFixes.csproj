<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>PandaBear.SharedKernel.Testing.CodeFixes</PackageId>
        <Description>Code fixes for repository test conventions.</Description>
        <RootNamespace>SharedKernel.Testing.CodeFixes</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;code-fixes;shared-kernel;dotnet</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <PackCompilerOutputs>true</PackCompilerOutputs>
        <PackOwnCompilerOutput>true</PackOwnCompilerOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Testing.Analyzers\SharedKernel.Testing.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" PackCompilerOutput="true" />
        <Compile Include="..\SharedKernel.Style.CodeFixes\AllowListedFixAll.cs" Link="AllowListedFixAll.cs" />
        <Compile Include="..\SharedKernel.Testing.Analyzers\AssertionDelegateInlining.cs" Link="AssertionDelegateInlining.cs" />
        <Compile Include="..\SharedKernel.Testing.Analyzers\AssertionUserMessageOverload.cs" Link="AssertionUserMessageOverload.cs" />
        <Compile Include="../SharedKernel.Testing.Analyzers/TestMethodNameSegments.cs" Link="TestMethodNameSegments.cs" />
        <Compile Include="..\SharedKernel.Testing.Analyzers\TestingDiagnosticIds.cs" Link="TestingDiagnosticIds.cs" />
        <Compile Include="..\SharedKernel.Testing.Analyzers\TestScopeValues.cs" Link="TestScopeValues.cs" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\SharedKernel.Testing.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
    </ItemGroup>

</Project>
