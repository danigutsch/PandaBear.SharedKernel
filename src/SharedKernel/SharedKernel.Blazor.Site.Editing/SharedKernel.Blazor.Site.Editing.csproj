<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Blazor.Site.Editing</PackageId>
        <Description>Accessible administration editors for the site components' owner-editable data, such as the site theme, built on the Blazor form helpers.</Description>
        <RootNamespace>SharedKernel.Blazor.Site.Editing</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>blazor;razor-components;accessibility;theme;editor;shared-kernel;dotnet</PackageTags>
