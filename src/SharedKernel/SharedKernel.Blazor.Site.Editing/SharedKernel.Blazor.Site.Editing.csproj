    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.Blazor/SharedKernel.Blazor.csproj" />
        <ProjectReference Include="../SharedKernel.Blazor.Site/SharedKernel.Blazor.Site.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Blazor.Site.Editing.Tests.Unit" />
    </ItemGroup>

</Project>
