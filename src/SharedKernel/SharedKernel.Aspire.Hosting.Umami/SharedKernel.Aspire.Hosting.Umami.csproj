<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Aspire.Hosting.Umami</PackageId>
        <Description>Aspire hosting integration for a self-hosted Umami web analytics container with its own PostgreSQL database or one on an existing server, a generated app secret, a pinned image, and websites that are set up in Umami when it starts.</Description>
        <RootNamespace>SharedKernel.Aspire.Hosting.Umami</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>aspire;umami;analytics;privacy;postgresql;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <!-- The pinned PostgreSQL image of the database server. -->
        <ProjectReference Include="..\SharedKernel.Aspire.Hosting\SharedKernel.Aspire.Hosting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Aspire.Hosting.Tests" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
