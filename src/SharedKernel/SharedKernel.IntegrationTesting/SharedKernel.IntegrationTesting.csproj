<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>SharedKernel.IntegrationTesting</PackageId>
        <Description>Reusable Aspire and PostgreSQL integration-test helpers for SharedKernel test suites.</Description>
        <RootNamespace>SharedKernel.IntegrationTesting</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;integration-testing;aspire;postgresql;shared-kernel;dotnet</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Testing" />
    </ItemGroup>

</Project>
