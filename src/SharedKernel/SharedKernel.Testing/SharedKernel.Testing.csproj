<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Testing</PackageId>
        <Description>Reusable test traits, environment and culture scopes, temporary-directory lifetimes, repository-file lookup, process fakes, and source-generated call proxies.</Description>
        <RootNamespace>PandaBear.Testing</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;traits;shared-kernel;dotnet</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
        <PackCompilerOutputs>true</PackCompilerOutputs>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Testing.SourceGenerator\SharedKernel.Testing.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            PackCompilerOutput="true"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
            IsAspireProjectResource="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
