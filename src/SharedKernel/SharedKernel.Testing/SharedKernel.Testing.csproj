<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Testing</PackageId>
        <Description>Reusable test traits, environment and culture scopes, temporary-directory lifetimes, repository-file lookup, process fakes, and source-generated call proxies.</Description>
        <RootNamespace>PandaBear.Testing</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;traits;shared-kernel;dotnet</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
        <TestingSourceGeneratorPackageFile Condition="'$(REMOTE_CONTAINERS)' != 'true'">..\SharedKernel.Testing.SourceGenerator\bin\$(Configuration)\netstandard2.0\SharedKernel.Testing.SourceGenerator.dll</TestingSourceGeneratorPackageFile>
        <TestingSourceGeneratorPackageFile Condition="'$(REMOTE_CONTAINERS)' == 'true'">$(MSBuildThisFileDirectory)..\..\..\.build\bin\SharedKernel.Testing.SourceGenerator\$(Configuration)\netstandard2.0\SharedKernel.Testing.SourceGenerator.dll</TestingSourceGeneratorPackageFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Testing.SourceGenerator\SharedKernel.Testing.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
            IsAspireProjectResource="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="$(TestingSourceGeneratorPackageFile)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>

</Project>
