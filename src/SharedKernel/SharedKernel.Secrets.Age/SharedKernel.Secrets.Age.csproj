<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Secrets.Age</PackageId>
        <Description>The age and age-keygen provider of PandaBear.SharedKernel.Secrets: runs the local age and age-keygen program from an absolute path without a shell, with secrets on standard input and output only.</Description>
        <PackageTags>secrets;age;shared-kernel;dotnet</PackageTags>
        <RootNamespace>SharedKernel.Secrets.Age</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Secrets.Age.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
        <ProjectReference Include="..\SharedKernel.Secrets\SharedKernel.Secrets.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
