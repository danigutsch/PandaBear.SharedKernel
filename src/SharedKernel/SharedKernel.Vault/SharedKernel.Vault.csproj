<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Shipping the vault manager is a separate decision, so candidates do not pack its engine either. -->
        <IsPackable>false</IsPackable>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Vault</PackageId>
        <Description>Offline password vault engine: provider-neutral vault items, duplicate matching, field-by-field merging with decisions files, secret scanning and placement, password health, and value-free reports.</Description>
        <PackageTags>password-manager;vault;migration;secret-scanning;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Vault.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.Encodings\SharedKernel.Encodings.csproj" />
        <ProjectReference Include="..\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
        <ProjectReference Include="..\SharedKernel.IO\SharedKernel.IO.csproj" />
        <ProjectReference Include="..\SharedKernel.SecretScanning\SharedKernel.SecretScanning.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
