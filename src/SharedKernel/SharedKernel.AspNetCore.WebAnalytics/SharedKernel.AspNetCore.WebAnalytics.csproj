<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.AspNetCore.WebAnalytics</PackageId>
        <Description>Server-side, cookieless page-view analytics for ASP.NET Core: records HTML page views after the response and sends them from background queues to the configured targets, such as a self-hosted Umami, without a script, a cookie or the visitor's query values.</Description>
        <RootNamespace>SharedKernel.AspNetCore.WebAnalytics</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>aspnetcore;analytics;umami;privacy;page-views;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- The internal telemetry guard keeps a failing meter listener from failing a page. -->
        <ProjectReference Include="..\SharedKernel.AspNetCore\SharedKernel.AspNetCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.AspNetCore.WebAnalytics.Tests" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
