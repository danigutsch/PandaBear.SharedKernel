<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Aspire.Hosting</PackageId>
        <Description>Aspire AppHost helpers that are not tied to one container: generated secrets, self-origin variables, health checks that match the project environment, and pinned PostgreSQL and Redis image coordinates.</Description>
        <RootNamespace>PandaBear.Aspire.Hosting</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>aspire;apphost;hosting;secrets;health-checks;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" />
    </ItemGroup>
    <ItemGroup>
        <!-- The canonical ASPNETCORE_ENVIRONMENT name (governed literal SKSTYLE012); Aspire.Hosting already brings ASP.NET Core. -->
        <ProjectReference Include="..\SharedKernel.AspNetCore\SharedKernel.AspNetCore.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
