<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.ConfigurationFiles</PackageId>
        <Description>Reads the strict JSON configuration files that command-line tools take from a consuming repository: bounded size, repository-relative paths without symbolic links, source-generated deserialization, and errors that name the file and the JSON path.</Description>
        <PackageTags>configuration;json;command-line;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.ConfigurationFiles.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.IO\SharedKernel.IO.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
