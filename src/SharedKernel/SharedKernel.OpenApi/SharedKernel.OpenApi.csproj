<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>SharedKernel.OpenApi</PackageId>
        <Description>Reusable OpenAPI helpers for shared-kernel HTTP contract documentation.</Description>
        <RootNamespace>SharedKernel.OpenApi</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>openapi;http;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.OpenApi" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
