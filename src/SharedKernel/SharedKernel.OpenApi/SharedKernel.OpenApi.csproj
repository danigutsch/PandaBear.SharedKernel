<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>SharedKernel.OpenApi</PackageId>
        <Description>Reusable OpenAPI helpers for shared-kernel HTTP contract documentation.</Description>
        <RootNamespace>SharedKernel.OpenApi</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>openapi;http;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.OpenApi" />
        <ProjectReference Include="..\SharedKernel.ApiVersioning\SharedKernel.ApiVersioning.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.OpenApi.Tests" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
