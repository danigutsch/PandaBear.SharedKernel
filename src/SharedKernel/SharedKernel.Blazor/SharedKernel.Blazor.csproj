<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Blazor</PackageId>
        <Description>Accessible Blazor helpers for HTTP outcome messages, server validation, error summaries, handled-failure reporting, upload status, and bounded option search.</Description>
        <RootNamespace>SharedKernel.Blazor</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>blazor;accessibility;http-clients;validation;search;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.BuildingBlocks/SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="../SharedKernel.HttpClients/SharedKernel.HttpClients.csproj" />
        <ProjectReference Include="../SharedKernel.Results/SharedKernel.Results.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\SharedKernel.AspNetCore\TelemetryGuard.cs" Link="TelemetryGuard.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Blazor.Tests" />
    </ItemGroup>

</Project>
