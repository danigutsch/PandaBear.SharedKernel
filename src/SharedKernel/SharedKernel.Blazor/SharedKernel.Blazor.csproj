<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Blazor</PackageId>
        <Description>Accessible Blazor helpers for HTTP outcome messages, server validation, error summaries, handled-failure reporting, and upload status.</Description>
        <RootNamespace>PandaBear.Blazor</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>blazor;accessibility;http-clients;validation;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.HttpClients/SharedKernel.HttpClients.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Blazor.Tests" />
    </ItemGroup>

</Project>
