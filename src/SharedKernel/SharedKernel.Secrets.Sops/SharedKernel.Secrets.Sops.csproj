<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Secrets.Sops</PackageId>
        <Description>The sops provider of PandaBear.SharedKernel.Secrets: runs the local sops program from an absolute path without a shell, with secrets on standard input and output only.</Description>
        <PackageTags>secrets;sops;shared-kernel;dotnet</PackageTags>
        <RootNamespace>SharedKernel.Secrets.Sops</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Secrets.Sops.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
        <ProjectReference Include="..\SharedKernel.Secrets\SharedKernel.Secrets.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
