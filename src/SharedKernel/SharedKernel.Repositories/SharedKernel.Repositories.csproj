<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Repositories</PackageId>
        <Description>Forge-neutral repository governance: reads the consumer configuration, plans and applies baseline files, starts new repositories, keeps the roadmap model, and verifies links, Gherkin, JSON, text encoding, line endings, action pins, Dependabot ignores, license exceptions, and security documents.</Description>
        <PackageTags>repository;governance;baseline;roadmap;verification;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Repositories.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.ConfigurationFiles\SharedKernel.ConfigurationFiles.csproj" />
        <ProjectReference Include="..\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
        <ProjectReference Include="..\SharedKernel.IO\SharedKernel.IO.csproj" />
        <ProjectReference Include="..\SharedKernel.Processes\SharedKernel.Processes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="NuGetMetadata/Resolver.cs.txt" LogicalName="NuGetMetadata.Resolver.cs" WithCulture="false" />
        <EmbeddedResource Include="NuGetMetadata/Resolver.csproj.txt" LogicalName="NuGetMetadata.Resolver.csproj" WithCulture="false" />
        <EmbeddedResource Include="NuGetVersionSources.cs;NuGetVersionRequestPackage.cs;NuGetVersionRequest.cs;NuGetVersionSet.cs;NuGetVersionResponse.cs"
                          LogicalName="NuGetMetadata.%(Filename)%(Extension)" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
