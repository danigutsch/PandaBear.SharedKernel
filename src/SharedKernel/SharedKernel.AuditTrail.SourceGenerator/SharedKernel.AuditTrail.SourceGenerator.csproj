<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>PandaBear.SharedKernel.AuditTrail.SourceGenerator</PackageId>
        <Description>Source generator for typed domain-event to audit-trail mappings.</Description>
        <RootNamespace>PandaBear.AuditTrail.SourceGenerator</RootNamespace>
        <PackageTags>audit-trail;domain-events;source-generator;shared-kernel;dotnet</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <Nullable>enable</Nullable>
        <NuspecFile>SharedKernel.AuditTrail.SourceGenerator.nuspec</NuspecFile>
        <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
        <NuspecProperties>packageVersion=$(PackageVersion);targetFramework=$(RepositoryTargetFramework)</NuspecProperties>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Use the evaluated build output path and initialized source control metadata for the custom nuspec. -->
    <Target Name="SetAuditTrailNuspecProperties" BeforeTargets="GenerateNuspec" DependsOnTargets="InitializeSourceControlInformation">
        <PropertyGroup>
            <NuspecProperties>$(NuspecProperties);analyzerFile=$(TargetPath);repositoryUrl=$(RepositoryUrl);repositoryCommit=$(SourceRevisionId)</NuspecProperties>
        </PropertyGroup>
    </Target>

</Project>
