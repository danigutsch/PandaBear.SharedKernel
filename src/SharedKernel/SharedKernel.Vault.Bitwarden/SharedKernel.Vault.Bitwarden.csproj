<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Shipping the vault manager is a separate decision, so candidates do not pack its engine either. -->
        <IsPackable>false</IsPackable>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Vault.Bitwarden</PackageId>
        <Description>Bitwarden provider for the SharedKernel vault engine: reads Bitwarden JSON, password-protected JSON, CSV, and zip exports offline, and writes JSON exports that Bitwarden and Vaultwarden import.</Description>
        <PackageTags>password-manager;vault;bitwarden;vaultwarden;migration;shared-kernel;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharedKernel.Vault.Bitwarden.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Vault\SharedKernel.Vault.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
