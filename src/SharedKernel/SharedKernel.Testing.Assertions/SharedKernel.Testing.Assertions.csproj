<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Testing.Assertions</PackageId>
        <Description>Reusable assertion extensions for SharedKernel xUnit test suites.</Description>
        <RootNamespace>PandaBear.Testing.Assertions</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>testing;assertions;xunit;shared-kernel;dotnet</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.assert" VersionOverride="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../SharedKernel.Results/SharedKernel.Results.csproj" />
    </ItemGroup>

</Project>
