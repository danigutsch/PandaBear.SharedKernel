<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>PandaBear.SharedKernel.Blazor.CodeFixes</PackageId>
        <Description>Code fixes for Blazor component state and service-scope conventions.</Description>
        <RootNamespace>PandaBear.Blazor.CodeFixes</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>blazor;code-fixes;shared-kernel;dotnet</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\SharedKernel.Blazor.Analyzers\BlazorDiagnosticIds.cs" Link="BlazorDiagnosticIds.cs" />
        <Compile Include="..\SharedKernel.Blazor.Analyzers\BusyFlagPattern.cs" Link="BusyFlagPattern.cs" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\SharedKernel.Blazor.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
