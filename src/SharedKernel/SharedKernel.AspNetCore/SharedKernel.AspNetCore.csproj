<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.AspNetCore</PackageId>
        <Description>Reusable ASP.NET Core helpers for explicit application hosting defaults: security headers, trusted forwarded headers, CORS and unhandled-exception telemetry.</Description>
        <RootNamespace>PandaBear.AspNetCore</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>aspnetcore;security;cors;headers;telemetry;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.InputNormalization\SharedKernel.InputNormalization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The sibling AspNetCore packages share the internal telemetry helpers and the security-event reporter. -->
        <InternalsVisibleTo Include="SharedKernel.AspNetCore.Authentication" />
        <InternalsVisibleTo Include="SharedKernel.AspNetCore.RateLimiting" />
        <InternalsVisibleTo Include="SharedKernel.AspNetCore.Tests" />
        <InternalsVisibleTo Include="SharedKernel.AspNetCore.Authentication.Tests" />
        <InternalsVisibleTo Include="SharedKernel.AspNetCore.RateLimiting.Tests" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
