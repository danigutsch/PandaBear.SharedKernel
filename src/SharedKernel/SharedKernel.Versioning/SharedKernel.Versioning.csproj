<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>PandaBear.SharedKernel.Versioning</PackageId>
        <Description>Reusable SemVer and Conventional Commit release-impact primitives.</Description>
        <RootNamespace>PandaBear.Versioning</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/danigutsch/ViajantesTurismo</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>versioning;semver;conventional-commits;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
