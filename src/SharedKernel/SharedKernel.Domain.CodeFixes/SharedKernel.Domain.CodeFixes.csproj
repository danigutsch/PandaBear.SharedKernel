<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsAotCompatible>false</IsAotCompatible>
        <PackageId>PandaBear.SharedKernel.Domain.CodeFixes</PackageId>
        <Description>Code fixes for SharedKernel domain-model encapsulation conventions.</Description>
        <RootNamespace>PandaBear.Domain.CodeFixes</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>ddd;domain;code-fixes;shared-kernel;dotnet</PackageTags>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\SharedKernel.Domain.Analyzers\DomainDiagnosticIds.cs" Link="DomainDiagnosticIds.cs" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\SharedKernel.Domain.Analyzers\AnalyzerReleases.Unshipped.md" Link="AnalyzerReleases.Unshipped.md" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/" Visible="false" />
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
