<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
        <PackageId>PandaBear.SharedKernel.Mediator</PackageId>
        <Description>Runtime support surface for SharedKernel.Mediator.</Description>
        <RootNamespace>SharedKernel.Mediator</RootNamespace>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>mediator;dependency-injection;shared-kernel;dotnet</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharedKernel.Mediator.Abstractions\SharedKernel.Mediator.Abstractions.csproj" />
        <ProjectReference Include="..\SharedKernel.BuildingBlocks\SharedKernel.BuildingBlocks.csproj" />
        <ProjectReference Include="..\SharedKernel.Results\SharedKernel.Results.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\SharedKernel.Observability\DurationBuckets.cs" Link="DurationBuckets.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
