<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <MediatorRoslynAnalyzersVersion>5.9.0</MediatorRoslynAnalyzersVersion>
    <MediatorRoslynVersion>5.9.0</MediatorRoslynVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire packages -->
    <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <PackageVersion Include="Aspire.Npgsql" Version="13.6.5" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.StackExchange.Redis.OutputCaching" Version="13.6.5" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.k6" Version="13.6.1" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.OpenTelemetryCollector" Version="13.6.1" />
    <!-- ASP.NET Core and web packages -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <!-- Direct dependency of SharedKernel.OpenApi; aligned with Microsoft.AspNetCore.OpenApi's minimum version. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <!-- Data and storage packages -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Postgres" Version="1.2.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Messaging packages -->
    <PackageVersion Include="CloudNative.CloudEvents" Version="2.9.0" />
    <PackageVersion Include="CloudNative.CloudEvents.Protobuf" Version="2.9.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <!-- Microsoft.Extensions packages -->
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.11.0" />
    <!-- OpenTelemetry packages -->
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AWS" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.21.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <!-- Roslyn and MSBuild packages -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    <!-- Tool and utility packages -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <!-- Exact version: Terminal.Gui minor versions contain breaking changes, so an upgrade follows its release notes. -->
    <PackageVersion Include="Terminal.Gui" Version="[2.5.0]" />
    <!-- Test packages -->
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Playwright.Xunit.v3" Version="1.64.1" />
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <!-- Transitive security pins -->
    <!-- StreamJsonRpc 2.25.29 resolves vulnerable MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h). Aspire.Hosting 13.6.5 requires MessagePack 2.5.307 and this pin matches it. Remove this transitive pin when StreamJsonRpc resolves MessagePack 2.5.303 or a later patched version. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!-- .NET 10.0.15 security release (2026-11-10). Aspire 13.6.5, Microsoft.Extensions.Http.Diagnostics 10.11.0, and StackExchange.Redis 2.13.17 still request older versions, and no newer release of them requests 10.0.15. Remove each pin when every package that requests it requires 10.0.15 or later. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.15" />
  </ItemGroup>
  <!-- net11.0 builds use the .NET 11 line of every package that ships one line per .NET version. The items above hold the
       net10.0 versions; see docs/dotnet-multi-targeting.md. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.QuickGrid" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Data.Sqlite.Core" Version="11.0.0" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Compliance.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Compliance.Redaction" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Diagnostics" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Telemetry" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Update="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Update="System.Security.Cryptography.Xml" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Update="System.IO.Hashing" Version="11.0.0" />
    <!-- Microsoft.AspNetCore.OpenApi 11.0.0 requires Microsoft.OpenApi 3.11.0 or later. -->
    <PackageVersion Update="Microsoft.OpenApi" Version="3.11.0" />
  </ItemGroup>
</Project>
